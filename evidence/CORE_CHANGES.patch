+def generate_scene_visuals(scenes: list[dict[str, Any]], project_id: str = "demo",
+                           pexels_api_key: Optional[str] = None,
+                           custom_clips: Optional[dict[str, str]] = None,
+                           scene_providers: Optional[dict[str, str]] = None,
