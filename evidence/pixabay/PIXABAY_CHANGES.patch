+class Response:
+    def __init__(self, payload=None, content=b'', status=200, headers=None):
+        self.payload = payload
+        self.content = content
+        self.status_code = status
+        self.headers = headers or {}
+    def __enter__(self):
+        return self
+    def __exit__(self, *args):
+        return False
+    def json(self):
+        return self.payload
+    def iter_content(self, size):
+        yield self.content
+
