# Keep real credentials in .env locally; never share/commit that file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
PEXELS_API_KEY=
# Optional additional stock-video source; add the key using the UI or here.
PIXABAY_API_KEY=
# Optional absolute paths. Leave blank when both programs are on PATH.
FFMPEG_EXE=
FFPROBE_EXE=
# Native Telugu on Linux requires this font to be installed locally.
# SUBTITLE_FONT_NATIVE=Noto Sans Telugu
